{
  "name": "docmatch-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "size": "pnpm --filter docmatch size"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "1.49",
    "@types/node": "^22.20.5",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  },
  "description": "DocMatch: comprueba en el navegador que un PDF es la plantilla oficial pedida y tiene los datos obligatorios"
}
